# Copy to .env. .env and .env.* are gitignored (.env.example is the only tracked one).
# Never commit real values. Secrets are read from the environment only; loadConfig rejects
# a secret key in a config file. Empty secret values are placeholders: fill every required one.

# Instance name, lowercase: /^[a-z][a-z0-9-]{0,30}$/
INSTANCE=personal

# Secrets: environment only, never in config.example.json or another config file.
DATABASE_URL=
# Disposable database for integration/e2e tests only; never the one apps use.
TEST_DATABASE_URL=
# Never point these two at the same Redis instance.
REDIS_QUEUE_URL=
REDIS_SLOT_URL=
LINEAR_API_KEY=
# At least 32 characters.
API_TOKEN=

# Non-secret settings; these values are the defaults.
LINEAR_TEAM_KEY=
API_PORT=3000
# Comma-separated HTTP(S) URL origins, e.g. https://app.example.com,http://localhost:5173
ALLOWED_ORIGINS=
SLOT_COUNT=3
POLL_INTERVAL_MS=30000
MAX_ENQUEUE_PER_POLL=2
MAX_OPEN_PROPOSALS=20
RUN_RETENTION_DAYS=30
MAX_ATTEMPTS=3
DRY_RUN=true
REPO_PATH=
# Defaults to $HOME/runs/$INSTANCE when unset.
# RUNS_DIR=
