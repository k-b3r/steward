# Copy to .env. .env and .env.* are gitignored (.env.example is the only tracked one).
# Never commit real values. Secrets are read from the environment only; loadConfig rejects
# a secret key in a config file. Empty secret values are placeholders: fill every required one.

# Instance name, lowercase: /^[a-z][a-z0-9-]{0,30}$/
INSTANCE=personal

# The account this instance pushes as, and the identity the agent commits with in its container.
# Non-secret. The token is never stored here: it is read at push time with
# `gh auth token --user <GH_ACCOUNT>`.
GH_ACCOUNT=your-github-login
GIT_USER_NAME=Your Name
GIT_USER_EMAIL=you@example.com

# Secrets: environment only, never in config.example.json or another config file.
DATABASE_URL=
# Disposable database for integration/e2e tests only; never the one apps use.
TEST_DATABASE_URL=
# Never point these two at the same Redis instance.
REDIS_QUEUE_URL=
REDIS_SLOT_URL=
LINEAR_API_KEY=
# At least 32 characters.
API_TOKEN=

# Non-secret settings; these values are the defaults.
LINEAR_TEAM_KEY=
API_PORT=3000
# Comma-separated HTTP(S) URL origins, e.g. https://app.example.com,http://localhost:5173
ALLOWED_ORIGINS=
# Extra exact Host values a trusted proxy forwards (no scheme, no wildcard), e.g. kb-pc.example.ts.net
ALLOWED_HOSTS=
BASE_BRANCH=main
# Where the built dashboard lives, served from the API's origin. Empty serves only /v1.
DASHBOARD_DIR=
# The tracker statuses the orchestrator may move a ticket into. Only a confirm does this.
ALLOWED_STATUSES=In Progress
SLOT_COUNT=3
POLL_INTERVAL_MS=30000
MAX_ENQUEUE_PER_POLL=2
MAX_OPEN_PROPOSALS=20
RUN_RETENTION_DAYS=30
MAX_ATTEMPTS=3
DRY_RUN=true
REPO_PATH=
# Defaults to $HOME/steward-instances/$INSTANCE/runs when unset.
# RUNS_DIR=

# The agent runner: `echo` (the stub) or `pi` (the real agent in a container).
RUNNER=echo
# Pi image and the model pattern (which LLM the agent runs on).
PI_IMAGE=steward-pi:1.5.0
PI_MODEL=
# The model provider key: the LLM credential the agent calls the provider with (an OpenCode Go key
# for DeepSeek, or an Anthropic key). Not the Linear key, not the GitHub token, not API_TOKEN.
# A secret: set it here, never in config.example.json. Use a key with a spend cap.
PI_MODEL_API_KEY=
# The provider's own variable name the container reads that key from.
PI_MODEL_API_KEY_ENV=OPENCODE_API_KEY
PI_TURN_CAP=40
PI_TIMEOUT_MS=1200000
# owner/name the claim pushes to and opens the draft PR on. Required when CLAIM_ENABLED=true.
# Not wired into the worker yet.
WORKSPACE_REPO=
# Open a draft pull request as the claim, and run the checks before any push.
CLAIM_ENABLED=false
# Not wired yet: the publish module exists, nothing calls it.
VALIDATION_ENABLED=false
# Absolute path to this instance's validation config (JSON), in the instance folder and never in the
# target repo: the agent must not be able to edit the checks it is judged by. Required when
# VALIDATION_ENABLED=true.
VALIDATION_CONFIG_FILE=
# Image the checks run in. Empty uses PI_IMAGE.
VALIDATION_IMAGE=
