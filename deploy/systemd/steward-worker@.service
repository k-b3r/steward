# steward worker for one instance: `systemctl --user enable --now steward-worker@personal`
# The worker writes transcripts under %h/runs/%i (the default RUNS_DIR from
# src/platform/config.ts). Create that directory before the first start: the
# unit fails to start when the ReadWritePaths= path does not exist. If RUNS_DIR
# points elsewhere, change both RUNS_DIR and ReadWritePaths, or the worker
# cannot write: ProtectSystem=strict makes the rest read-only.
# Phase 3 also needs the configured REPO_PATH writable for git worktrees.
[Unit]
Description=steward worker (%i)
Requires=steward-%i-postgres.service steward-%i-redis-queue.service steward-%i-redis-slots.service
After=steward-%i-postgres.service steward-%i-redis-queue.service steward-%i-redis-slots.service
# The container units are generated by Quadlet from ~/.config/containers/systemd/.

[Service]
Type=simple
WorkingDirectory=%h/steward
EnvironmentFile=%h/.config/steward/%i.env
ExecStart=/usr/bin/node dist/entries/worker.js
Restart=on-failure
RestartSec=5
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=%h/runs/%i
PrivateTmp=yes

[Install]
WantedBy=default.target
