# steward worker for one instance: `systemctl --user enable --now steward-worker@personal`
# The worker writes transcripts under %h/steward/runs/%i (the default RUNS_DIR from
# src/platform/config.ts). Create that directory before the first start. If RUNS_DIR points
# elsewhere, change both RUNS_DIR and ReadWritePaths. As a USER unit on Ubuntu 24.04 the
# filesystem rules below are not enforced (see docs/decisions.md); they take effect for a
# system unit.
# The worker also runs `git fetch` and `git worktree add` inside the clone under
# %h/steward/repos/%i, which writes to that clone's .git, so that tree is writable too
# (the leading '-' means a missing directory is not an error).
[Unit]
Description=steward worker (%i)
Requires=steward-%i-postgres.service steward-%i-redis-queue.service steward-%i-redis-slots.service
After=steward-%i-postgres.service steward-%i-redis-queue.service steward-%i-redis-slots.service
# The container units are generated by Quadlet from ~/.config/containers/systemd/.

[Service]
Type=simple
WorkingDirectory=%h/steward
EnvironmentFile=%h/.config/steward/%i.env
ExecStart=/usr/bin/node dist/entries/worker.js
Restart=on-failure
RestartSec=5
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=%h/steward/runs/%i -%h/steward/repos/%i
PrivateTmp=yes

[Install]
WantedBy=default.target
