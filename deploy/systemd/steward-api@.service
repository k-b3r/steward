# steward API for one instance: `systemctl --user enable --now steward-api@personal`
# The environment file holds every secret (see .env.example). It lives outside
# the repository, mode 0600. All ports are published on 127.0.0.1 by the
# Quadlet containers, and the API itself binds 127.0.0.1 only.
[Unit]
Description=steward API (%i)
Requires=steward-%i-postgres.service steward-%i-redis-queue.service steward-%i-redis-slots.service
After=steward-%i-postgres.service steward-%i-redis-queue.service steward-%i-redis-slots.service
# The container units are generated by Quadlet from ~/.config/containers/systemd/.

[Service]
Type=simple
# The app checkout, not the per-instance data folder; edit if cloned elsewhere.
WorkingDirectory=%h/steward
EnvironmentFile=%h/steward-instances/%i/.env
ExecStart=/usr/bin/node dist/entries/api.js
Restart=on-failure
RestartSec=5
NoNewPrivileges=yes
ProtectSystem=strict
PrivateTmp=yes

[Install]
WantedBy=default.target
